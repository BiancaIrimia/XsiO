<Window x:Class="XsiO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XsiO"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TablaJoc" Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button00" Click="OnCellClick" Width="100" Height="100" Background="MediumOrchid" BorderThickness="0">
                    <Image x:Name="Image00" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button01" Click="OnCellClick" Width="100" Height="100" Background="LightCoral" BorderThickness="0">
                    <Image x:Name="Image01" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button02" Click="OnCellClick" Width="100" Height="100" Background="LightPink" BorderThickness="0">
                    <Image x:Name="Image02" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button10" Click="OnCellClick" Width="100" Height="100" Background="LightPink" BorderThickness="0">
                    <Image x:Name="Image10" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button11" Click="OnCellClick" Width="100" Height="100" Background="LightPink" BorderThickness="0">
                    <Image x:Name="Image11" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button12" Click="OnCellClick" Width="100" Height="100" Background="LightPink" BorderThickness="0">
                    <Image x:Name="Image12" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button20" Click="OnCellClick" Width="100" Height="100" Background="LightPink" BorderThickness="0">
                    <Image x:Name="Image20" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button21" Click="OnCellClick" Width="100" Height="100" Background="LightCoral" BorderThickness="0">
                    <Image x:Name="Image21" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="5">
                <Button x:Name="Button22" Click="OnCellClick" Width="100" Height="100" Background="LightCoral" BorderThickness="0">
                    <Image x:Name="Image22" Visibility="Collapsed" Stretch="Uniform"/>
                </Button>
            </Border>
        </Grid>

        <Button x:Name="JoacaDinNou"
        Grid.Row="2"
        Grid.Column="1"
        Content="Joaca din nou"
        Click="JoacaDinNou_Click"
        Width="200" Height="30"
        FontSize="12"
        FontWeight="SemiBold"
        Background="#FF007ACC"
        Foreground="White"
        BorderThickness="0">
        </Button>

    </Grid>
</Window>
